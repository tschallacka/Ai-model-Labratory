# Allow-list: this repository holds only the petri viewer and the server behind it.
# Everything else in this folder (datasets, chats, measurements) stays local.
/*
!/.gitignore
!/README.md
!/model.py
!/model_torch.py
!/profile_ffn.py
!/env/
/env/*
!/env/flake.nix
!/env/flake.lock
!/sources/
/sources/*
!/sources/hf/
!/petri/
!/notes/
# Petri dishes are made locally by petri/mini.py; model.npz is ~185 MB, over GitHub's 100 MB file limit.
/petri/dishes/
__pycache__/
